apiVersion: v1
kind: Secret
metadata:
  name: changeguard-secrets
  namespace: changeguard
type: Opaque
stringData:
  OPENAI_API_KEY: "replace-with-your-key"
  GITHUB_TOKEN: "replace-with-github-token"
  DOCKER_USERNAME: "replace-with-docker-user"
  DOCKER_PASSWORD: "replace-with-docker-password"
  REGISTRY_URL: "https://index.docker.io/v1/"
